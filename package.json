{
  "name": "ai-visibility",
  "version": "0.3.0",
  "description": "Auto-generate robots.txt, llms.txt, and JSON-LD schema to make your Node.js or Next.js app visible and citable by AI crawlers (GPTBot, ClaudeBot, PerplexityBot) and track AI bot traffic.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./detector": {
      "import": {
        "types": "./dist/detector.d.mts",
        "default": "./dist/detector.mjs"
      },
      "require": {
        "types": "./dist/detector.d.ts",
        "default": "./dist/detector.js"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema.d.mts",
        "default": "./dist/schema.mjs"
      },
      "require": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.js"
      }
    },
    "./generators": {
      "import": {
        "types": "./dist/generators.d.mts",
        "default": "./dist/generators.mjs"
      },
      "require": {
        "types": "./dist/generators.d.ts",
        "default": "./dist/generators.js"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.mts",
        "default": "./dist/express.mjs"
      },
      "require": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.mts",
        "default": "./dist/next.mjs"
      },
      "require": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "detector": ["./dist/detector.d.ts"],
      "schema": ["./dist/schema.d.ts"],
      "generators": ["./dist/generators.d.ts"],
      "express": ["./dist/express.d.ts"],
      "next": ["./dist/next.d.ts"]
    }
  },
  "bin": {
    "ai-visibility": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsup && npm run build:shebang",
    "build:shebang": "node -e \"const fs = require('fs'); const path = require('path'); const cliPath = path.join('dist', 'cli', 'index.js'); let content = fs.readFileSync(cliPath, 'utf8'); if (!content.startsWith('#!/usr/bin/env node')) { content = '#!/usr/bin/env node\\n' + content.replace(/^#!.*\\n/, ''); fs.writeFileSync(cliPath, content); }\"",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "ready-to-publish": "npm run check && echo '✅ All checks passed! Safe to publish.'",
    "prepare": "husky install",
    "prepublishOnly": "npm run build && npm run test",
    "publish:npm": "npm run check && npm publish --registry https://registry.npmjs.org/",
    "publish:github": "npm run check && npm publish --registry https://npm.pkg.github.com/",
    "release": "npm run ready-to-publish && npm run publish:npm && npm run publish:github && echo '✅ Published to npm and GitHub Packages!'"
  },
  "keywords": [
    "ai-seo",
    "llms.txt",
    "ai-visibility",
    "generative-engine-optimization",
    "geo",
    "answer-engine-optimization",
    "aeo",
    "ai-crawler",
    "gptbot",
    "claudebot",
    "perplexitybot",
    "json-ld",
    "schema",
    "robots.txt",
    "bot-detection",
    "nodejs",
    "nextjs",
    "edge-runtime",
    "middleware",
    "seo"
  ],
  "author": "Muhammad Faizan <muhammadfaizanjanjua109@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muhammadfaizanjanjua109/ai-visibility.git"
  },
  "bugs": {
    "url": "https://github.com/Muhammadfaizanjanjua109/ai-visibility/issues"
  },
  "homepage": "https://github.com/Muhammadfaizanjanjua109/ai-visibility#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Muhammadfaizanjanjua109"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.4.0",
    "eslint": "^8.0.0",
    "express": "^4.18.0",
    "happy-dom": "^14.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.0.0",
    "next": "^14.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "peerDependencies": {
    "express": ">=4.0.0",
    "next": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
